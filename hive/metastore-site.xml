<?xml version="1.0" encoding="UTF-8"?>
<!-- Catálogo: metadados no MariaDB, arquivos no SILO. ${env.X} vem do docker-compose. -->
<configuration>
  <property><name>javax.jdo.option.ConnectionURL</name><value>jdbc:mysql://mariadb:3306/metastore_db?useSSL=false&amp;allowPublicKeyRetrieval=true</value></property>
  <property><name>javax.jdo.option.ConnectionDriverName</name><value>com.mysql.cj.jdbc.Driver</value></property>
  <property><name>javax.jdo.option.ConnectionUserName</name><value>hive</value></property>
  <property><name>javax.jdo.option.ConnectionPassword</name><value>${env.HMS_DB_PASSWORD}</value></property>
  <property><name>metastore.thrift.port</name><value>9083</value></property>
  <property><name>metastore.warehouse.dir</name><value>s3a://warehouse/</value></property>
  <property><name>metastore.expression.proxy</name><value>org.apache.hadoop.hive.metastore.DefaultPartitionExpressionProxy</value></property>
  <property><name>metastore.task.threads.always</name><value>org.apache.hadoop.hive.metastore.events.EventCleanerTask</value></property>
  <property><name>fs.s3a.endpoint</name><value>http://silo:9000</value></property>
  <property><name>fs.s3a.access.key</name><value>${env.S3_USER}</value></property>
  <property><name>fs.s3a.secret.key</name><value>${env.S3_PASSWORD}</value></property>
  <property><name>fs.s3a.path.style.access</name><value>true</value></property>
  <property><name>fs.s3a.connection.ssl.enabled</name><value>false</value></property>
  <property><name>fs.s3a.impl</name><value>org.apache.hadoop.fs.s3a.S3AFileSystem</value></property>
</configuration>
