# Copie para .env e troque as senhas. O .env não vai para o git.

# Postgres de origem (faz o papel do sistema transacional)
PG_DB=cursos_oltp
PG_USER=cursos
PG_PASSWORD=troque-me

# SILO (armazenamento S3, fork comunitário do MinIO). Senha com 8+ caracteres.
S3_USER=lakeadmin
S3_PASSWORD=troque-me-tambem

# MariaDB (banco do Hive Metastore)
HMS_DB_PASSWORD=troque-me
HMS_DB_ROOT_PASSWORD=troque-me

# Airflow
AIRFLOW_DB_PASSWORD=troque-me
AIRFLOW_ADMIN_PASSWORD=troque-me
AIRFLOW_SECRET_KEY=troque-me

# Superset
SUPERSET_ADMIN_PASSWORD=troque-me
SUPERSET_SECRET_KEY=troque-me
